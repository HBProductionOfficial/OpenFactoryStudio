; TargetPowerAdd: Adds to the power of targets
[State 0, TargetPowerAdd]
type = TargetPowerAdd
trigger1 =
value = 0                       ; power added
;ID = 0                         ; identifier
;ignorehitpause = 0             ; 1 = also run during hit pauses
;persistent = 1                 ; 0 = once per state, n = every n-th time
