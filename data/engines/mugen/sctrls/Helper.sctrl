; Helper: Spawns a helper, a copy of the player running its own states
[State 0, Helper]
type = Helper
trigger1 =
;helpertype = Normal            ; player type is unsupported: Normal, Player
;name = "Helper"                ; name in quotes
;ID = 1                         ; identifier
;pos = 0, 0                     ; x, y
;postype = P1                   ; what pos is relative to: P1, P2, Front, Back, Left, Right
;facing = 1                     ; 1 or -1
;stateno = 0                    ; state number
;keyctrl = 0                    ; 1 = reads commands
;ownpal = 0                     ; 1 = own palette
;remappal = -1, 0               ; group, item of the palette to use (1.1+)
;supermovetime = 0              ; ticks unfrozen in a SuperPause
;pausemovetime = 0              ; ticks unfrozen in a Pause
;size.xscale = 1                ; helper x scale
;size.yscale = 1                ; helper y scale
;size.ground.back = 0           ; helper width
;size.ground.front = 0          ; helper width
;size.air.back = 0              ; helper width
;size.air.front = 0             ; helper width
;size.height = 0                ; helper height
;size.proj.doscale = 0          ; 1 = scale projectiles
;size.head.pos = 0, 0           ; x, y
;size.mid.pos = 0, 0            ; x, y
;size.shadowoffset = 0          ; shadow offset
;ignorehitpause = 0             ; 1 = also run during hit pauses
;persistent = 1                 ; 0 = once per state, n = every n-th time
