; TargetBind: Holds targets at a position relative to the player
[State 0, TargetBind]
type = TargetBind
trigger1 =
;time = 1                       ; duration in ticks
;ID = -1                        ; identifier
;pos = 0, 0                     ; x, y
;ignorehitpause = 0             ; 1 = also run during hit pauses
;persistent = 1                 ; 0 = once per state, n = every n-th time
