; LifeAdd: Adds to the player's life
[State 0, LifeAdd]
type = LifeAdd
trigger1 =
value = 0                       ; life added
;kill = 1                       ; 0 = cannot KO
;absolute = 0                   ; 1 = ignore attack/defence
