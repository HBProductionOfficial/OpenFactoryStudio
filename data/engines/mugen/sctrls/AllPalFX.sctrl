; AllPalFX: Palette effect on the whole screen: players, stage and lifebars
[State 0, AllPalFX]
type = AllPalFX
trigger1 =
;time = 10                      ; duration in ticks
;add = 0, 0, 0                  ; r, g, b added
;mul = 256, 256, 256            ; r, g, b multiplier (256 = 1)
;sinadd = 0, 0, 0, 1            ; r, g, b amplitude, period
;invertall = 0                  ; 1 = negative colours
;color = 256                    ; 0 = grey, 256 = normal
;ignorehitpause = 0             ; 1 = also run during hit pauses
;persistent = 1                 ; 0 = once per state, n = every n-th time
