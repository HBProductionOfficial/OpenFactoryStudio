; PosAdd: Moves the player by an offset
[State 0, PosAdd]
type = PosAdd
trigger1 =
x = 0                           ; x component
y = 0                           ; y component
;ignorehitpause = 0             ; 1 = also run during hit pauses
;persistent = 1                 ; 0 = once per state, n = every n-th time
